<div style="background:#fff;border:1px solid #e8e5e0;border-radius:10px;padding:18px 20px">
<div style="font:600 10px/1 -apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,sans-serif;letter-spacing:.1em;color:#8a8680;margin-bottom:12px">EVERYTHING ELSE</div>
<div style="display:grid;grid-template-columns:120px 1fr 190px 150px;gap:0;font-size:12.5px">
